{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jakegold1647/sam-doctor/main/docs/schemas/sarif-report.schema.json",
  "title": "SAM Doctor SARIF report payload",
  "description": "A narrowed contract for the SARIF 2.1.0 log SAM Doctor emits with --format sarif. This checks the shape sam-doctor produces, not the full upstream SARIF spec.",
  "type": "object",
  "required": ["$schema", "version", "runs"],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "version": {
      "type": "string",
      "const": "2.1.0"
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/run"
      }
    }
  },
  "additionalProperties": true,
  "definitions": {
    "run": {
      "type": "object",
      "required": ["tool", "results"],
      "properties": {
        "tool": {
          "$ref": "#/definitions/tool"
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/result"
          }
        }
      },
      "additionalProperties": true
    },
    "tool": {
      "type": "object",
      "required": ["driver"],
      "properties": {
        "driver": {
          "type": "object",
          "required": ["name", "version", "informationUri", "rules"],
          "properties": {
            "name": {
              "type": "string",
              "const": "sam-doctor"
            },
            "version": {
              "type": "string"
            },
            "informationUri": {
              "type": "string",
              "format": "uri"
            },
            "rules": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/rule"
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "rule": {
      "type": "object",
      "required": ["id", "shortDescription", "helpUri"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable sam-doctor rule id, e.g. `iam.deny.explicit`."
        },
        "shortDescription": {
          "type": "object",
          "required": ["text"],
          "properties": {
            "text": {
              "type": "string"
            }
          }
        },
        "helpUri": {
          "type": "string",
          "format": "uri",
          "description": "Documentation link for the matched rule, carried over from the finding's documentation_url."
        }
      },
      "additionalProperties": true
    },
    "result": {
      "type": "object",
      "required": ["ruleId", "level", "message", "locations"],
      "properties": {
        "ruleId": {
          "type": "string"
        },
        "level": {
          "type": "string",
          "enum": ["error", "warning", "note"],
          "description": "high confidence findings map to error, medium to warning, low to note."
        },
        "message": {
          "type": "object",
          "required": ["text"],
          "properties": {
            "text": {
              "type": "string"
            }
          }
        },
        "locations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["physicalLocation"],
            "properties": {
              "physicalLocation": {
                "type": "object",
                "required": ["artifactLocation", "region"],
                "properties": {
                  "artifactLocation": {
                    "type": "object",
                    "required": ["uri"],
                    "properties": {
                      "uri": {
                        "type": "string"
                      }
                    }
                  },
                  "region": {
                    "type": "object",
                    "required": ["startLine"],
                    "properties": {
                      "startLine": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "additionalProperties": true
    }
  }
}
