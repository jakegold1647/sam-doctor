{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jakegold1647/sam-doctor/main/docs/schemas/batch-report.schema.json",
  "title": "SAM Doctor batch report payload",
  "type": "object",
  "required": ["sam_doctor_version", "batch_count", "results"],
  "properties": {
    "sam_doctor_version": {
      "type": "string",
      "description": "Version string from sam_doctor.__version__."
    },
    "batch_count": {
      "type": "integer",
      "minimum": 0
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/result"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "result": {
      "type": "object",
      "required": ["source", "finding_count", "findings"],
      "properties": {
        "source": {
          "type": "string",
          "description": "Redacted source file path."
        },
        "finding_count": {
          "type": "integer",
          "minimum": 0
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "diagnose-report.schema.json#/definitions/finding"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
